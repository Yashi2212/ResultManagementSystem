<link rel="stylesheet" href="/css/home.css">

<%- include('../partials/header.ejs') %>

<% if (success_msg && success_msg.length > 0) { %>
    <div class="alert alert-success fade-alert">
      <%= success_msg %>
    </div>
  <% } %>
  
  <% if (error_msg && error_msg.length > 0) { %>
    <div class="alert alert-danger fade-alert">
      <%= error_msg %>
    </div>
  <% } %>
  
  <% if (info_msg && info_msg.length > 0) { %>
    <div class="alert alert-info fade-alert">
      <%= info_msg %>
    </div>
  <% } %>
  <div class="container-fluid mt-4" style="margin-bottom: 15px;">
    <div class="row">
        <div class="col-6">
           <a href="/teacher/add" ><button type="button" class="btn btn-warning btn-sm">Add Student</button></a>
        </div>
        <div class="col-6 text-right">
          <a href="/logout"><button type="button" class="btn btn-secondary btn-sm">Logout</button>
          </a>
        </div>
    </div>
</div>

<div class="container">
  <div style="float: left;">
  </div>

          <table class="table table-bordered table-hover">
            <thead class="thead-dark">
                <tr>
                    <th>Roll No</th>
                    <th>Name</th>
                    <th>Date of Birth</th>
                    <th>Score</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
              <% for(let i=0;i<studentdata.length;i++){%>
                <tr>
                    <td><%= studentdata[i].rollno %>
                    </td>
                    <td><%= studentdata[i].name %></td>
                    <td><%= datearr[i] %></td>
                    <td><%= studentdata[i].score %>/100</td>

                    <td class="action-buttons" class="align-middle">
                     
                    <a href="/teacher/edit/<%= studentdata[i]._id %>"><button class="btn btn-primary btn-sm m-1"><i class="fas fa-edit"></i>&nbsp; Edit &nbsp;</button></a>

                   <form action="/teacher/home/<%= studentdata[i]._id %>" type="submit" method="get">
                      <button class="btn btn-danger btn-sm">
                        <i class="fas fa-trash-alt"></i> Delete
                      </button>
                   </form>
                      </td>
                </tr>

                <%}%>

            </tbody>
        </table>
        </div>
        <%- include('../partials/footer.ejs') %>

        <script src="/js/home.js" type="text/javascript"></script>

