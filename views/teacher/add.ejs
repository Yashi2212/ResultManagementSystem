<%- include('../partials/header.ejs') %>

    <% if (success_msg && success_msg.length > 0) { %>
        <div class="alert alert-success fade-alert alert-dismissible fade show" role="alert">
          <%= success_msg %><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="close"></button>
        </div>
      <% } %>
      
      <% if (error_msg && error_msg.length > 0) { %>
        <div class="alert alert-danger fade-alert">
          <%= error_msg %>
        </div>
      <% } %>
      
      <% if (info_msg && info_msg.length > 0) { %>
        <div class="alert alert-info fade-alert">
          <%= info_msg %>
        </div>
      <% } %>
    

<link rel="stylesheet" href="/css/add.css">

<div class="container-fluid mt-4" style="margin-bottom: 15px;">
  <div class="row">
      <div class="col-6">
        <form action="/teacher/home" method="get">
          <button type="submit"  class="btn btn-secondary btn-sm">Back</button>

        </form> 
      </div>
      <!-- <div class="col-6 text-right">
          <button type="button" class="btn btn-secondary btn-sm">Logout</button>
      </div> -->
  </div>
</div>


    <div class="container">
        <div class="row">
            <div class="col-md-6 offset-md-3 student-form">
                <h2>Add Student</h2>
                <form action="/teacher/add" method="post" id="studentForm">

                    <div class="form-group">
                        <label for="rollno">Roll Number:</label>
                        <input type="number" class="form-control" id="rollno" name="rollno" placeholder="Enter Roll No" value="">
                    </div>
                    <div class="form-group">
                        <label for="name">Name:</label>
                        <input type="text" class="form-control" id="name" name="name" placeholder="Enter Student's Name" value="">
                    </div>
                    <div class="form-group">
                        <label for="dob">Date of Birth:</label>
                        <input type="date" class="form-control" id="dob" name="dob" placeholder="Enter Date of Birth " value="">
                    </div>
                    <div class="form-group">
                        <label for="score">Score:</label>
                        <input type="number" class="form-control" id="score" name="score" placeholder="Enter the Score" value="">
                    </div>
                    <button type="submit" class="btn btn-submit btn-block">Add Student</button>

                </form>
            </div>
        </div>
    </div>
    <%- include('../partials/footer.ejs') %>
<script>

window.addEventListener('DOMContentLoaded', (event) => {
    const alerts = document.querySelectorAll('.fade-alert');
    alerts.forEach(alert => {
        setTimeout(() => {
            alert.style.display = 'none';
        }, 2500);
    });
});
</script>
